# NexHire backend environment variables.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ── Runtime ─────────────────────────────────────────────
NEXHIRE_ENV=development                      # development | staging | production
NEXHIRE_LOG_LEVEL=INFO
NEXHIRE_API_PREFIX=/api/v1

# ── Database (Azure Postgres Flexible Server) ───────────
# Host: e.g. nexhire-dev.postgres.database.azure.com
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/nexhire
DATABASE_POOL_SIZE=10
DATABASE_POOL_OVERFLOW=20

# ── Redis (Azure Cache for Redis) ───────────────────────
REDIS_URL=rediss://:PASSWORD@HOST:6380/0

# ── Azure AD (OIDC SSO via MSAL) ────────────────────────
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=                       # store in Key Vault in prod
AZURE_AD_AUTHORITY=https://login.microsoftonline.com/${AZURE_AD_TENANT_ID}
AZURE_AD_REDIRECT_URI=http://localhost:5173/auth/callback

# ── JWT (RS256, NexHire-issued) ─────────────────────────
JWT_PRIVATE_KEY_PEM=                          # multi-line; in prod read from Key Vault
JWT_PUBLIC_KEY_PEM=
JWT_KID=nexhire-jwt-2026
JWT_ISSUER=https://nexhire.local
JWT_AUDIENCE=nexhire-api
JWT_ACCESS_TTL_SECONDS=28800                  # 8h
JWT_REFRESH_TTL_SECONDS=86400                 # 24h

# ── Azure Key Vault ─────────────────────────────────────
AZURE_KEY_VAULT_URL=https://nexhire-dev-kv.vault.azure.net/
# DefaultAzureCredential auto-picks the right identity source.

# ── Azure Blob Storage ──────────────────────────────────
AZURE_BLOB_ACCOUNT_URL=https://nexhiredev.blob.core.windows.net
AZURE_BLOB_CONTAINER_DOCUMENTS=documents
AZURE_BLOB_CONTAINER_TEMP=temp-uploads

# ── Azure OpenAI (GPT-4o) ───────────────────────────────
# NOTE: GPT-4o availability in South India must be verified.
# If unavailable, deploy in Central India / East US 2 and call cross-region.
AZURE_OPENAI_ENDPOINT=https://nexhire-aoai.openai.azure.com/
AZURE_OPENAI_API_KEY=                          # or use managed identity
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o
AZURE_OPENAI_DEPLOYMENT_EMBEDDINGS=text-embedding-3-large

# ── Azure Document Intelligence (ID/cert reading) ──────
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://nexhire-docintel.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=

# ── Azure Application Insights ──────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── Microsoft Graph (AD provisioning) ───────────────────
GRAPH_TENANT_ID=${AZURE_AD_TENANT_ID}
GRAPH_CLIENT_ID=${AZURE_AD_CLIENT_ID}
GRAPH_CLIENT_SECRET=${AZURE_AD_CLIENT_SECRET}

# ── Gmail Workspace API ────────────────────────────────
GMAIL_SERVICE_ACCOUNT_JSON_PATH=/secrets/gmail-sa.json
GMAIL_SENDER_EMAIL=nexhire-noreply@example.com
GMAIL_DOMAIN_DELEGATED_USER=admin@example.com

# ── OpenSign (self-hosted on ACI) ──────────────────────
OPENSIGN_BASE_URL=https://opensign.nexhire.internal
OPENSIGN_API_KEY=
OPENSIGN_WEBHOOK_SIGNING_SECRET=

# ── PAN encryption (HMAC pepper + AES key) ─────────────
# In prod both are read from Key Vault by reference, never inline.
PAN_HMAC_PEPPER=                               # 32+ random bytes, hex-encoded
PAN_AES_KEY=                                   # 32 bytes, hex-encoded (AES-256)

# ── Rate limiting ───────────────────────────────────────
RATE_LIMIT_PER_MINUTE_DEFAULT=120
RATE_LIMIT_PER_MINUTE_AI=20
RATE_LIMIT_PER_MINUTE_UNAUTH=10

# ── AI cost guardrail ───────────────────────────────────
AI_DAILY_COST_CEILING_INR=2000

# ── First superuser bootstrap (alembic seed) ───────────
SEED_PROGRAM_OWNER_EMAIL=program-owner@example.com
SEED_PROGRAM_OWNER_NAME=NexHire Program Owner
